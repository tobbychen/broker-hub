# Broker Agents — Environment Variables Template
# Copy this file to .env and fill in your actual values
#
# QUICK START:
# 1. cp .env.example .env
# 2. Fill in your API keys below
# 3. Run: ./start.sh (Linux/Mac) or start.bat (Windows)
# 4. Access dashboard at http://localhost:5173

# ===== LLM Provider (required) =====
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_MODEL=auto
MINIMAX_BASE_URL=https://api.minimax.chat/v1

# ===== Fallback LLM Providers (optional) =====
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1

# ===== Market Data APIs =====
# Binance (crypto) - https://www.binance.com/
BINANCE_API_KEY=
BINANCE_SECRET=

# eBay (sports cards & merchandise) - https://developer.ebay.com/
EBAY_CLIENT_ID=your_ebay_client_id_here
EBAY_CLIENT_SECRET=your_ebay_client_secret_here

# Amazon PA-API (merchandise) - https://affiliate-program.amazon.com/
# Requires Amazon Associates account
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=your_tag-20

# JD Open Platform (merchandise) - https://open.jd.com/
# Requires JD developer account + shop verification
JD_APP_KEY=
JD_APP_SECRET=

# ===== Notification (Telegram) =====
# Create bot: https://t.me/BotFather
# Get chat_id: https://t.me/userinfobot (send message first, then check)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ===== Database =====
DB_PATH=data/broker_agents.db
DB_BACKUP_PATH=data/backups
