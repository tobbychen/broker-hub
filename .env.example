# Broker Agents — Environment Variables Template
# Copy this file to .env and fill in your actual values

# ===== LLM Provider (required) =====
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_MODEL=auto
MINIMAX_BASE_URL=https://api.minimax.chat/v1

# ===== Fallback LLM Providers (optional, for Phase 2) =====
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1

# ===== Market Data APIs (optional) =====
BINANCE_API_KEY=
BINANCE_SECRET=
EBAY_CLIENT_ID=your_ebay_client_id_here
EBAY_CLIENT_SECRET=your_ebay_client_secret_here

# ===== Amazon PA-API (for merchandise monitor) =====
# Requires Amazon Associates account to get credentials
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=

# ===== JD Open Platform (for merchandise monitor) =====
# Requires JD developer account + shop verification
JD_APP_KEY=
JD_APP_SECRET=

# ===== Notification (Telegram) =====
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ===== Database =====
DB_PATH=data/broker_agents.db
DB_BACKUP_PATH=data/backups
